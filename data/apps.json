      "defaultOpen": true,
      "content": {
        "type": "html",
        "html": "<section class=\"portfolio-section intro\">\n  <p class=\"eyebrow\">Front-end developer · curious maker</p>\n  <h1>Hi, I'm Marcy.</h1>\n  <p class=\"lead\">I build clear, playful interfaces with Vue and TypeScript. I like turning complicated ideas into things that feel understandable, useful and a little more human.</p>\n  <p>I enjoy creating reusable UI components, solving tricky interface behaviour and making experiences work well across different screen sizes. Away from the editor, I like hands-on creative projects, playful game ideas and learning by making.</p>\n  <div class=\"quick-facts\" aria-label=\"A few things about Marcy\">\n    <span>💻 Vue + TypeScript</span>\n    <span>🎨 Design-minded</span>\n    <span>🛠️ Learning by making</span>\n  </div>\n</section>"
      },
